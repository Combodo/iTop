# Copy this file to .docker/.env and adjust the values.
# .docker/.env is ignored by Git: never commit real credentials.

# Port of the web server on the host: iTop will be available on http://localhost:${HTTP_PORT}/
HTTP_PORT=8080
# Host address the port is published on. 127.0.0.1: only reachable from this computer.
# Use 0.0.0.0 to expose iTop on your network (then make sure to change the passwords below).
HTTP_BIND_ADDRESS=127.0.0.1

# Apache runs with this UID / GID so that files generated by iTop (conf/, data/, env-production/, log/)
# remain writable from the host. Use the output of `id -u` and `id -g`.
HOST_UID=1000
HOST_GID=1000

# Database (MariaDB service "db", only reachable from the compose network)
MARIADB_DATABASE=itop
MARIADB_USER=itop
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too

# iTop administrator created by install.sh
ITOP_ADMIN_LOGIN=admin
ITOP_ADMIN_PASSWORD=Change-me-123!
ITOP_LANGUAGE=EN US

# Load the demo data during the installation (1 / 0)
ITOP_SAMPLE_DATA=1
