{% set tileClass = 'manage' %}

{% extends 'itop-portal-base/portal/templates/bricks/tile.html.twig' %}

{% block pTileTitle %}
    {% apply spaceless %}
        <div class="ipb-tile--title {% if isInlineTitle %}ipb-tile--option--inline-title{% endif %}">
            <span>{{ oBrick.GetTitle()|dict_s }}</span>
            <span>{{ iCount }}</span>
        </div>
    {% endapply %}
{% endblock %}

