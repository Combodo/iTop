{% for sBlockIdentifier, oBlockToRedraw in blocks_to_redraw %}
    {% UITurboUpdate Standard { sTarget: "turbo_" ~ sBlockIdentifier} %}
    {% if oBlockToRedraw is not null %}
        {{ form_row(oBlockToRedraw) }}
    {% endif %}
    {% EndUITurboUpdate %}
{% endfor %}