{% extends 'base/layouts/activity-panel/activity-entry/layout.html.twig' %}

{% block iboActivityEntryExtraClasses %}ibo-edits-entry{% endblock %}

{% block iboActivityEntryMainInformationContent %}
    {% if not oUIBlock.HasHtmlComparisons() and (oUIBlock.GetAttributes()|length == 1) and (oUIBlock.GetAttributes()|first['descriptions']|length == 1) %}
        <span class="ibo-edits-entry--short-description">{{ oUIBlock.GetShortDescriptionAsHtml()|raw }}</span>
    {% else %}
        <a href="#" class="ibo-edits-entry--short-description" data-role="ibo-edits-entry--long-description-toggler">
            {# Note: In edits entry, the description toggler is positioned #}
            <span class="ibo-edits-entry--long-description-toggler-icon fa fa-caret-down"></span>
            {{ oUIBlock.GetShortDescriptionAsHtml()|raw }}
        </a>
        <ul class="ibo-edits-entry--long-description" data-role="ibo-edits-entry--long-description">
            {% for sAttCode, aAttData in oUIBlock.GetAttributes() %}
                {% if oUIBlock.HasHtmlComparison(sAttCode) %}
                    {% set aHtmlComparison = oUIBlock.GetHtmlComparison(sAttCode) %}
                    <li class="ibo-edits-entry--attribute-description" data-attribute-code="{{ sAttCode }}">
                        {{ aAttData.descriptions|first|raw }}
                        <div class="ibo-rich-text-diff--versions">
                            <div class="ibo-rich-text-diff--version ibo-rich-text-diff--version--previous">
                                <div class="ibo-rich-text-diff--version-title">{{ 'UI:CaseLog:Edition:PreviousVersion'|dict_s }}</div>
                                <div class="ibo-rich-text-diff--version-content">{{ aHtmlComparison.previous|raw }}</div>
                            </div>
                            <div class="ibo-rich-text-diff--version ibo-rich-text-diff--version--new">
                                <div class="ibo-rich-text-diff--version-title">{{ 'UI:CaseLog:Edition:NewVersion'|dict_s }}</div>
                                <div class="ibo-rich-text-diff--version-content">{{ aHtmlComparison.new|raw }}</div>
                            </div>
                        </div>
                    </li>
                {% else %}
                    {% for sAttHtmlDescription in aAttData.descriptions %}
                        <li class="ibo-edits-entry--attribute-description" data-attribute-code="{{ sAttCode }}">{{ sAttHtmlDescription|raw }}</li>
                    {% endfor %}
                {% endif %}
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}