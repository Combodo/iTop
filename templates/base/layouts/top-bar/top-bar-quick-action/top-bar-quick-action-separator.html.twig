<div id="{{ oUIBlock.GetId() }}"
     class="ibo-top-bar-quick-action ibo-top-bar-quick-action-separator"
     data-role="ibo-top-bar-quick-action-separator"
     {% if oUIBlock.GetDataAttributes() %}
         {% for sName, sValue in oUIBlock.GetDataAttributes() %}
             data-{{ sName }}="{{ sValue }}"
         {% endfor %}
     {% endif %}
     {% if oUIBlock.GetAriaAttributes() %}
         {% for sName, sValue in oUIBlock.GetAriaAttributes() %}
             aria-{{ sName }}="{{ sValue }}"
         {% endfor %}
     {% endif %}
>
</div>
