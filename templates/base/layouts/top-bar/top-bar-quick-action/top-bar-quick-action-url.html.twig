<div id="{{ oUIBlock.GetId() }}"
     data-role="ibo-top-bar-quick-action">
    <div class="ibo-top-bar-quick-action--head" data-role="ibo-top-bar-quick-action--head">
        <a href="{{ oUIBlock.GetURL() }}" class="ibo-top-bar-quick-action--icon" data-role="ibo-top-bar-quick-action--icon"
           target="{{ oUIBlock.GetTarget() }}"
           aria-label="{{ oUIBlock.GetTooltip() }}"
           data-tooltip-content="{{ oUIBlock.GetTooltip() }}"
           data-tooltip-placement="bottom-start"
           data-tooltip-distance-offset="25"
        >
            <span class="{{ oUIBlock.GetIconClass() }}"></span>
        </a>
    </div>
</div>